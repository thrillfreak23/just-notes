\kerning0\cf0\ftnbj\fet2\ftnstart1\ftnnar\aftnnar\ftnstart1\aftnstart1\aenddoc\revprop3{\*\rdf}{\info\uc1{\author rachel}}\deftab720\viewkind1\paperw12240\paperh15840\margl1440\margr1440\widowctrl
